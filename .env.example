BOT_TOKEN=your_telegram_bot_token

# WPGraphQL endpoint of the wp-coins site. All catalogue, auth and collection
# calls go through it (app/api.js). Required: the bot throws without it.
API_BASE_URL=https://coins.cybers.pro/graphql

# Comma-separated Telegram user IDs allowed to run /stats. Leave unset to
# leave the command open to everyone (fine for dev/small-scale use).
BOT_ADMIN_IDS=
# Public https URL of the r-numismat web app. When set, /start shows an
# "Open app" button, /app is added to the command menu, and the chat menu
# button opens the Mini App. Leave unset to disable.
WEBAPP_URL=
